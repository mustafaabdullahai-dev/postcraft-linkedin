# ─────────────────────────────────────────────────────────────
# LinkedIn AI Content Agent — Environment Configuration
# Copy this file to `.env` and fill in real credentials.
# NEVER commit your real `.env` file.
# ─────────────────────────────────────────────────────────────

ENVIRONMENT=development
APP_NAME=LinkedIn AI Content Agent
# Signing key for session tokens. CHANGE THIS in production!
SECRET_KEY=dev-secret-change-me-in-production

# ── Text model (LLM) ──────────────────────────────────────────
# auto  -> picks first available: openrouter, groq, deepseek, openai, qwen,
#          anthropic, then mock
# openai -> uses OPENAI_API_KEY
# groq   -> uses GROQ_API_KEY (fast LPU inference, OpenAI-compatible)
# qwen   -> uses QWEN_API_KEY (OpenAI-compatible DashScope endpoint)
# deepseek -> uses DEEPSEEK_API_KEY (OpenAI-compatible, cheap + fast)
# mock   -> deterministic offline demo output (no API needed)
TEXT_PROVIDER=auto

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Best Groq model currently available for text generation + structured output.
# (llama-3.3-70b-versatile was retired Aug 2026; gpt-oss-120b supports strict
# JSON schema, tool use and JSON mode.)
GROQ_MODEL=openai/gpt-oss-120b
# json_schema  = strict structured outputs (supported by gpt-oss/qwen3.8-27b)
# function_calling = fallback for models that force tool calls reliably
STRUCTURED_OUTPUT_METHOD=json_schema

# Qwen Cloud (Model Studio) — OpenAI-compatible
# secret: set DASHSCOPE_API_KEY as QWEN_API_KEY (the compatible endpoint uses it)
QWEN_API_KEY=
QWEN_BASE_URL=https://maas.qwencloudapi.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen3.7-plus
# Enable reasoning tokens for deep-thinking models (chat-style). For the
# structured nodes prefer a JSON-friendly model or method below.
QWEN_ENABLE_THINKING=false

# DeepSeek — OpenAI-compatible (platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# deepseek-chat  -> general + tool calling (safe for the structured nodes)
# deepseek-reasoner -> stronger drafts, but no tool calls / temperature control
DEEPSEEK_MODEL=deepseek-chat
# DeepSeek has no strict json_schema response_format, so keep this on
# function_calling regardless of STRUCTURED_OUTPUT_METHOD.
DEEPSEEK_STRUCTURED_OUTPUT_METHOD=function_calling

# ── Image generation (Gemini / Qwen Cloud) ────────────────────
# gemini -> native Google Gemini (generativelanguage.googleapis.com)
# qwen   -> forces the Qwen OpenAI-compatible image API
# auto   -> Gemini first, then Qwen, else a local SVG mock
IMAGE_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Model Studio API key (the dashscope-related key the console calls
# DASHSCOPE_API_KEY). Paste it here or export DASHSCOPE_API_KEY:
QWEN_API_KEY=
QWEN_BASE_URL=https://maas.qwencloudapi.com/compatible-mode/v1
QWEN_IMAGE_MODEL=wan2.2-t2i-flash
IMAGE_SIZE=1024x1024

# ── LinkedIn API ──────────────────────────────────────────────
# "Sign in with LinkedIn" is a Google-style OIDC login. Like Google Login, it
# NEEDS a one-time LinkedIn app (client id + secret) — paste them here and the
# blue 'Sign in with LinkedIn' button works for everyone:
LINKEDIN_DRY_RUN=true
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Leave empty → auto-derived as {FRONTEND_URL}/api/auth/linkedin/callback
# (must be added as an allowed redirect URL in your LinkedIn app).
LINKEDIN_REDIRECT_URI=
# Global fallback credentials (single-user deployments only).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
# With LINKEDIN_DRY_RUN=true (default) the whole login-free "continue as
# guest" demo flow works with no LinkedIn app at all.

# ── Google Sheets logging ─────────────────────────────────────
# dry_run=true logs to a local JSONL audit file instead of Sheets.
GOOGLE_SHEETS_DRY_RUN=true
# Either paste the full service-account JSON here (single line),
# or set a path: GOOGLE_SERVICE_ACCOUNT_JSON=file:./creds.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# ── App ───────────────────────────────────────────────────────
DATA_DIR=./data
# The frontend origin (OAuth callback redirects here).
FRONTEND_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
LOG_LEVEL=INFO

# ── Optional settings ─────────────────────────────────────────
# Defaults are fine for local development; see app/core/config.py for the full
# list and their meanings.
TRUSTED_PROXIES=127.0.0.1,::1
SECURITY_HEADERS=true
DOCS_ENABLED=true
ALLOW_GUEST_LOGIN=true
RATE_LIMIT_PER_MINUTE=0
DAILY_GENERATIONS_PER_USER=0
DAILY_IMAGES_PER_USER=0
GLOBAL_DAILY_AI_CALLS=5000
# Review uploaded images against LinkedIn's image rules: auto | qwen | gemini | off
VISION_PROVIDER=auto